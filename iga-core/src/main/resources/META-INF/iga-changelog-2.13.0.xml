<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <!-- 1: Create IGA_SERVER_CERT_ENROLLMENT_TOKEN table (one-time server-cert enrollment tokens) -->
    <changeSet id="iga-2.13.0-1" author="tidecloak-iga">
        <createTable tableName="IGA_SERVER_CERT_ENROLLMENT_TOKEN">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CLIENT_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="TOKEN_HASH" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_AT" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRES_AT" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="CONSUMED_AT" type="BIGINT"/>
            <column name="CREATED_BY" type="VARCHAR(36)"/>
        </createTable>

        <createIndex tableName="IGA_SERVER_CERT_ENROLLMENT_TOKEN"
                     indexName="UX_IGA_SCET_REALM_HASH" unique="true">
            <column name="REALM_ID"/>
            <column name="TOKEN_HASH"/>
        </createIndex>

        <createIndex tableName="IGA_SERVER_CERT_ENROLLMENT_TOKEN"
                     indexName="IDX_IGA_SCET_REALM_CLIENT">
            <column name="REALM_ID"/>
            <column name="CLIENT_ID"/>
        </createIndex>
    <!--
      2.13.0: The expiry of a time-limited policy.

      EXPIRY - epoch SECONDS, matching exactly what the policy itself carries and
               signs: a little-endian int64 at index 7 of its DataToVerify
               (Midgard Policy v4, Ork.Shared Policy v4). BIGINT rather than a
               timestamp because the signed representation is the point. A
               converted value would have to be turned back into seconds to
               rebuild the policy, and any drift there produces different bytes
               and therefore a signature that no longer verifies.

      This column is a READ-BACK of what POLICY already contains, kept beside it
      so a time-limited policy can be found without parsing every blob (the
      expiry sweep, and "which grants lapse soon"). It is NOT a second authority.
      Nothing may consult EXPIRY to decide access: PolicyAuthorizationFlow on
      every ork rejects an expired policy after verifying its signature, and
      PolicySignRequest refuses to sign one that has already lapsed. A server
      that read this column to answer "may they" would be overriding a rule the
      network owns, with nothing to detect it having done so.

      Nullable, and existing rows backfill to NULL, which is the correct legacy
      semantic: a policy written before this column could not carry an expiry at
      all, because the layout that holds one did not exist. NULL means a standing
      policy, never an expired or unknown one.
    -->

    <changeSet id="iga-2.13.0-1" author="tidecloak-iga">
        <addColumn tableName="IGA_ROLE_POLICY">
            <column name="EXPIRY" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
