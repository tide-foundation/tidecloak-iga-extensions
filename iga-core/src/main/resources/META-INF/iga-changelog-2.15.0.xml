<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <!-- 1: Create IGA_REALM_CERT table (backs IgaRealmCertEntity).

         Realm-scoped counterpart to IGA_SERVER_CERT_DRAFT: one row per realm-certificate
         issuance, holding the P-256 realm server certificate and the Ed25519 realm root CA.
         Both are realm-wide, so they live here rather than being duplicated onto every
         per-client server-cert row (where the TRUST_BUNDLE / REALM_CERTIFICATE columns used
         to sit before they were dropped). -->
    <changeSet id="iga-2.15.0-1" author="tidecloak-iga">
        <createTable tableName="IGA_REALM_CERT">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CHANGE_REQUEST_ID" type="VARCHAR(36)"/>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <!-- Realm server certificate (P-256, Tidecloak's own keypair) -->
            <column name="SERVER_CSR" type="clob"/>
            <column name="SERVER_PUBLIC_KEY" type="clob"/>
            <column name="SERVER_PUBLIC_KEY_FINGERPRINT" type="VARCHAR(255)"/>
            <column name="SERVER_SERIAL_NUMBER" type="VARCHAR(64)"/>
            <column name="SERVER_CERTIFICATE" type="clob"/>
            <column name="SERVER_NOT_BEFORE" type="BIGINT"/>
            <column name="SERVER_NOT_AFTER" type="BIGINT"/>

            <!-- Realm root CA (Ed25519, the threshold gVVK — no CSR, the cohort derives it) -->
            <column name="ROOT_CA_CERTIFICATE" type="clob"/>
            <column name="ROOT_CA_SERIAL_NUMBER" type="VARCHAR(64)"/>
            <column name="ROOT_CA_NOT_BEFORE" type="BIGINT"/>
            <column name="ROOT_CA_NOT_AFTER" type="BIGINT"/>

            <column name="REVOKED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="REVOKED_AT" type="BIGINT"/>
            <column name="CREATED_AT" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="BIGINT"/>
        </createTable>
    </changeSet>

    <!-- 2: Foreign key from IGA_REALM_CERT.CHANGE_REQUEST_ID to IGA_CHANGE_REQUEST.ID.
         SET NULL on delete, matching FK_IGA_SERVER_CERT_CR: purging a change request must not
         take an issued certificate with it. -->
    <changeSet id="iga-2.15.0-2" author="tidecloak-iga">
        <addForeignKeyConstraint constraintName="FK_IGA_REALM_CERT_CR"
                                 baseTableName="IGA_REALM_CERT"
                                 baseColumnNames="CHANGE_REQUEST_ID"
                                 referencedTableName="IGA_CHANGE_REQUEST"
                                 referencedColumnNames="ID"
                                 onDelete="SET NULL"/>
    </changeSet>

    <!-- 3: Index on REALM_ID — every lookup is "the current cert for this realm" -->
    <changeSet id="iga-2.15.0-3" author="tidecloak-iga">
        <createIndex tableName="IGA_REALM_CERT" indexName="IDX_IGA_REALM_CERT_REALM">
            <column name="REALM_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
